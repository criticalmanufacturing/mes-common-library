<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <packageSources>
        <add key="CMF-Public" value="https://criticalmanufacturing.io/repository/nuget-hosted/index.json" protocolVersion="3" />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    </packageSources>
    <disabledPackageSources>
        <add key="CMF-Public" value="true" />
    </disabledPackageSources>
    <solution>
        <add key="disableSourceControlIntegration" value="true" />
    </solution>
</configuration>
