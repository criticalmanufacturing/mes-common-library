{
  "name": "documentation-portal",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:libs": "ngx-tasks build && npm run build-db && npm run check-md-links",
    "docs-shell": "node ./node_modules/cmf-docs-shell/scripts/index.js",
    "build-db": "npm run docs-shell build-db",
    "check-md-links": "npm run docs-shell check-md-links",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "link:libs": "ngx-tasks link",
    "extract-i18n": "ng extract-i18n --output-path ./src/assets/ --format json",
    "serve": "cross-env NODE_OPTIONS=--max-old-space-size=8192 npm run start -- --host 0.0.0.0 --disable-host-check --port 7001"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^17.3.12",
    "@angular/common": "^17.3.12",
    "@angular/compiler": "^17.3.12",
    "@angular/core": "^17.3.12",
    "@angular/forms": "^17.3.12",
    "@angular/localize": "~17.3.12",
    "@angular/platform-browser": "^17.3.12",
    "@angular/platform-browser-dynamic": "^17.3.12",
    "@angular/router": "^17.3.12",
    "@angular/service-worker": "^17.3.12",
    "cmf-core": "release-1127",
    "cmf-core-business-controls": "release-1127",
    "cmf-core-controls": "release-1127",
    "cmf-core-shell": "release-1127",
    "cmf-docs-area-designsystem": "release-1127",
    "cmf-docs-controls": "release-1127",
    "cmf-docs-shell": "release-1127",
    "he": "^1.2.0",
    "katex": "^0.11.1",
    "less": "^4.3.0",
    "lunr": "^2.3.9",
    "marked": "^4.3.0",
    "marked-katex": "^0.3.8",
    "mermaid": "^9.1.3",
    "prismjs": "1.29.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "^0.14.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.3.16",
    "@angular-eslint/builder": "17.5.3",
    "@angular-eslint/eslint-plugin": "17.5.3",
    "@angular-eslint/eslint-plugin-template": "17.5.3",
    "@angular-eslint/schematics": "17.5.3",
    "@angular-eslint/template-parser": "17.5.3",
    "@angular/cli": "^17.3.16",
    "@angular/compiler-cli": "^17.3.12",
    "@criticalmanufacturing/ngx-schematics": "^11.0.8",
    "@types/backbone": "^1.4.15",
    "@types/jasmine": "~5.1.0",
    "@types/jquery": "^3.5.14",
    "@types/marked": "^4.0.7",
    "@typescript-eslint/eslint-plugin": "7.11.0",
    "@typescript-eslint/parser": "7.11.0",
    "concurrently": "^7.4.0",
    "eslint": "^8.57.1",
    "glob": "^8.0.3",
    "jasmine-core": "~5.1.2",
    "karma": "~6.4.1",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^17.3.0",
    "typescript": "~5.4.5",
    "yargs": "^17.6.2",
    "jquery-ui": "1.13.2",
    "cross-env": "^7.0.3"
  }
}
