        <QueryString
            value="SELECT&#xD;&#xA;    Project,&#xD;&#xA;    Package,&#xD;&#xA;    Version,&#xD;&#xA;    Converter,&#xD;&#xA;    argMax(NrParameters, _created_at) AS NrParameters,&#xD;&#xA;    argMax(LinesOfCode, _created_at)  AS LinesOfCode,&#xD;&#xA;    argMax(Bundled, _created_at)      AS Bundled,&#xD;&#xA;    argMax(Injects, _created_at)      AS Injects,&#xD;&#xA;    max(HasCode)                      AS HasCode,&#xD;&#xA;    max(_created_at)                  AS LastAudited&#xD;&#xA;FROM&#xD;&#xA;(&#xD;&#xA;    SELECT&#xD;&#xA;        Enterprise_Name AS Project, Site_Name AS Package, Facility_Name AS Version,&#xD;&#xA;        Resource_Name AS Converter, _created_at,&#xD;&#xA;        length(JSONExtractArrayRaw(coalesce(Parameters_StringValues[indexOf(Parameters_Name, 'Parameters')][1], '[]'))) AS NrParameters,&#xD;&#xA;        Parameters_NumericValues[indexOf(Parameters_Name, 'Lines of Code')][1] AS LinesOfCode,&#xD;&#xA;        -- The &quot;no longer used elsewhere&quot; boolean flag was renamed from 'ATL' to 'Bundled'&#xD;&#xA;        -- across scanner versions; fall back to whichever one is present on a given row.&#xD;&#xA;        coalesce(nullIf(Parameters_StringValues[indexOf(Parameters_Name, 'Bundled')][1], ''), Parameters_StringValues[indexOf(Parameters_Name, 'ATL')][1]) AS Bundled,&#xD;&#xA;        Parameters_StringValues[indexOf(Parameters_Name, 'Injects')][1] AS Injects,&#xD;&#xA;        if(has(Parameters_Name, 'Lines of Code'), 1, 0) AS HasCode&#xD;&#xA;    FROM PostTelemetry&#xD;&#xA;    WHERE Area_Name = 'Converter'&#xD;&#xA;)&#xD;&#xA;GROUP BY Project, Package, Version, Converter&#xD;&#xA;ORDER BY Project, Package, Converter"
            type="System.String, System.Private.CoreLib, Version=8.0.0.0, Culture=neutral, PublicKeyToken=7cec85d7bea7798e" />
