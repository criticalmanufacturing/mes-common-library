        <QueryString
            value="SELECT&#xD;&#xA;    controller.Project                  AS Project,&#xD;&#xA;    controller.Package                  AS Package,&#xD;&#xA;    controller.Version                  AS Version,&#xD;&#xA;    controller.ControllerName           AS ControllerName,&#xD;&#xA;    controller.ControllerScope          AS ControllerScope,&#xD;&#xA;    coalesce(driverdef_link.DriverDefinitionName, '') AS DriverDefinitionName,&#xD;&#xA;    coalesce(protocol_link.AutomationProtocol, '')    AS AutomationProtocol,&#xD;&#xA;    coalesce(protocol.DriverPackage, '')              AS DriverPackage,&#xD;&#xA;    coalesce(protocol.DriverPackageVersion, '')       AS DriverPackageVersion,&#xD;&#xA;    coalesce(workflow.WorkflowCount, 0)               AS WorkflowCount&#xD;&#xA;FROM&#xD;&#xA;(&#xD;&#xA;    SELECT&#xD;&#xA;        Enterprise_Name AS Project,&#xD;&#xA;        Site_Name       AS Package,&#xD;&#xA;        Facility_Name   AS Version,&#xD;&#xA;        Resource_Name   AS ControllerName,&#xD;&#xA;        argMax(JSONExtractString(Parameters_StringValues[indexOf(Parameters_Name, 'Content')][1], 'Scope'), _created_at) AS ControllerScope&#xD;&#xA;    FROM PostTelemetry&#xD;&#xA;    WHERE Area_Name = '&lt;DM&gt;AutomationController'&#xD;&#xA;    GROUP BY Project, Package, Version, ControllerName&#xD;&#xA;) AS controller&#xD;&#xA;LEFT JOIN&#xD;&#xA;(&#xD;&#xA;    SELECT&#xD;&#xA;        Enterprise_Name AS Project,&#xD;&#xA;        ControllerName,&#xD;&#xA;        argMax(DriverDefinitionName, _created_at) AS DriverDefinitionName&#xD;&#xA;    FROM&#xD;&#xA;    (&#xD;&#xA;        SELECT&#xD;&#xA;            Enterprise_Name,&#xD;&#xA;            _created_at,&#xD;&#xA;            JSONExtractString(Parameters_StringValues[indexOf(Parameters_Name, 'Content')][1], 'AutomationController') AS ControllerName,&#xD;&#xA;            JSONExtractString(Parameters_StringValues[indexOf(Parameters_Name, 'Content')][1], 'AutomationDriverDefinition') AS DriverDefinitionName&#xD;&#xA;        FROM PostTelemetry&#xD;&#xA;        WHERE Area_Name = 'AutomationControllerDriverDef'&#xD;&#xA;    )&#xD;&#xA;    GROUP BY Project, ControllerName&#xD;&#xA;) AS driverdef_link&#xD;&#xA;ON controller.Project = driverdef_link.Project AND controller.ControllerName = driverdef_link.ControllerName&#xD;&#xA;LEFT JOIN&#xD;&#xA;(&#xD;&#xA;    SELECT&#xD;&#xA;        Enterprise_Name AS Project,&#xD;&#xA;        DriverDefinitionName,&#xD;&#xA;        argMax(AutomationProtocol, _created_at) AS AutomationProtocol&#xD;&#xA;    FROM&#xD;&#xA;    (&#xD;&#xA;        SELECT&#xD;&#xA;            Enterprise_Name,&#xD;&#xA;            _created_at,&#xD;&#xA;            Resource_Name AS DriverDefinitionName,&#xD;&#xA;            JSONExtractString(Parameters_StringValues[indexOf(Parameters_Name, 'Content')][1], 'AutomationProtocol') AS AutomationProtocol&#xD;&#xA;        FROM PostTelemetry&#xD;&#xA;        WHERE Area_Name = '&lt;DM&gt;AutomationDriverDefinition'&#xD;&#xA;    )&#xD;&#xA;    GROUP BY Project, DriverDefinitionName&#xD;&#xA;) AS protocol_link&#xD;&#xA;ON driverdef_link.Project = protocol_link.Project AND driverdef_link.DriverDefinitionName = protocol_link.DriverDefinitionName&#xD;&#xA;LEFT JOIN&#xD;&#xA;(&#xD;&#xA;    SELECT&#xD;&#xA;        Enterprise_Name AS Project,&#xD;&#xA;        AutomationProtocol,&#xD;&#xA;        argMax(DriverPackage, _created_at)        AS DriverPackage,&#xD;&#xA;        argMax(DriverPackageVersion, _created_at) AS DriverPackageVersion&#xD;&#xA;    FROM&#xD;&#xA;    (&#xD;&#xA;        SELECT&#xD;&#xA;            Enterprise_Name,&#xD;&#xA;            _created_at,&#xD;&#xA;            Resource_Name AS AutomationProtocol,&#xD;&#xA;            JSONExtractString(Parameters_StringValues[indexOf(Parameters_Name, 'Content')][1], 'Package') AS DriverPackage,&#xD;&#xA;            JSONExtractString(Parameters_StringValues[indexOf(Parameters_Name, 'Content')][1], 'PackageVersion') AS DriverPackageVersion&#xD;&#xA;        FROM PostTelemetry&#xD;&#xA;        WHERE Area_Name = '&lt;DM&gt;AutomationProtocol'&#xD;&#xA;    )&#xD;&#xA;    GROUP BY Project, AutomationProtocol&#xD;&#xA;) AS protocol&#xD;&#xA;ON protocol_link.Project = protocol.Project AND protocol_link.AutomationProtocol = protocol.AutomationProtocol&#xD;&#xA;LEFT JOIN&#xD;&#xA;(&#xD;&#xA;    SELECT&#xD;&#xA;        Project,&#xD;&#xA;        ControllerName,&#xD;&#xA;        uniqExact(WorkflowName) AS WorkflowCount&#xD;&#xA;    FROM&#xD;&#xA;    (&#xD;&#xA;        SELECT DISTINCT&#xD;&#xA;            Enterprise_Name AS Project,&#xD;&#xA;            Resource_Name   AS WorkflowName,&#xD;&#xA;            JSONExtractString(Parameters_StringValues[indexOf(Parameters_Name, 'Content')][1], 'AutomationController') AS ControllerName&#xD;&#xA;        FROM PostTelemetry&#xD;&#xA;        WHERE Area_Name = 'AutomationControllerWorkflow'&#xD;&#xA;    )&#xD;&#xA;    GROUP BY Project, ControllerName&#xD;&#xA;) AS workflow&#xD;&#xA;ON controller.Project = workflow.Project AND controller.ControllerName = workflow.ControllerName&#xD;&#xA;ORDER BY Project, Package, Version, ControllerName"
            type="System.String, System.Private.CoreLib, Version=8.0.0.0, Culture=neutral, PublicKeyToken=7cec85d7bea7798e" />
