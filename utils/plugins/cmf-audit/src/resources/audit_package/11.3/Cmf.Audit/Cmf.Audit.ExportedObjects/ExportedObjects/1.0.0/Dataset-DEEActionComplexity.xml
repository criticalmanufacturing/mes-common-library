        <Path value="UserDefined.DEEActionComplexity"
            type="System.String, System.Private.CoreLib, Version=8.0.0.0, Culture=neutral, PublicKeyToken=7cec85d7bea7798e" />
        <QueryString
            value="SELECT&#xD;&#xA;    deeaction.Project AS Project,&#xD;&#xA;    deeaction.Package AS Package,&#xD;&#xA;    deeaction.Version AS Version,&#xD;&#xA;    deeaction.Action AS Action,&#xD;&#xA;    deeaction.Classification AS Classification,&#xD;&#xA;    deeaction.IsEnabled AS IsEnabled,&#xD;&#xA;    metrics.Complexity AS Complexity,&#xD;&#xA;    metrics.LinesOfCode AS LinesOfCode,&#xD;&#xA;    if(metrics.FileNameKey != '', 1, 0) AS HasMetrics,&#xD;&#xA;    deeaction.LastAudited AS LastAudited&#xD;&#xA;FROM&#xD;&#xA;(&#xD;&#xA;    SELECT&#xD;&#xA;        Project, Package, Version, Action,&#xD;&#xA;        argMax(FileNameKey, _created_at)    AS FileNameKey,&#xD;&#xA;        argMax(Classification, _created_at) AS Classification,&#xD;&#xA;        argMax(IsEnabled, _created_at)       AS IsEnabled,&#xD;&#xA;        max(_created_at)                     AS LastAudited&#xD;&#xA;    FROM&#xD;&#xA;    (&#xD;&#xA;        SELECT&#xD;&#xA;            Enterprise_Name AS Project, Site_Name AS Package, Facility_Name AS Version,&#xD;&#xA;            Resource_Name AS Action, _created_at,&#xD;&#xA;            extract(JSONExtractString(Parameters_StringValues[indexOf(Parameters_Name, 'Content')][1], 'CodeFileRelativePath'), '([^/]+)$') AS FileNameKey,&#xD;&#xA;            JSONExtractString(Parameters_StringValues[indexOf(Parameters_Name, 'Content')][1], 'Classification') AS Classification,&#xD;&#xA;            JSONExtractString(Parameters_StringValues[indexOf(Parameters_Name, 'Content')][1], 'IsEnabled')       AS IsEnabled&#xD;&#xA;        FROM PostTelemetry&#xD;&#xA;        WHERE Area_Name = '&lt;SM&gt;DEEAction'&#xD;&#xA;    )&#xD;&#xA;    GROUP BY Project, Package, Version, Action&#xD;&#xA;) AS deeaction&#xD;&#xA;LEFT JOIN&#xD;&#xA;(&#xD;&#xA;    -- Complexity/LoC are captured under a separate audited entity (Area_Name='DEE',&#xD;&#xA;    -- Resource_Name='codeExecution'), keyed by source file basename rather than Action&#xD;&#xA;    -- name, so the join happens on the file name extracted from CodeFileRelativePath.&#xD;&#xA;    SELECT&#xD;&#xA;        Project, Package, Version, FileNameKey,&#xD;&#xA;        argMax(LoC, _created_at)        AS LinesOfCode,&#xD;&#xA;        argMax(Complexity, _created_at) AS Complexity&#xD;&#xA;    FROM&#xD;&#xA;    (&#xD;&#xA;        SELECT&#xD;&#xA;            Enterprise_Name AS Project, Site_Name AS Package, Facility_Name AS Version, _created_at,&#xD;&#xA;            Parameters_StringValues[indexOf(Parameters_Name, 'FileName')][1]  AS FileNameKey,&#xD;&#xA;            Parameters_NumericValues[indexOf(Parameters_Name, 'LoC')][1]        AS LoC,&#xD;&#xA;            Parameters_NumericValues[indexOf(Parameters_Name, 'Complexity')][1] AS Complexity&#xD;&#xA;        FROM PostTelemetry&#xD;&#xA;        WHERE Area_Name = 'DEE' AND Resource_Name = 'codeExecution'&#xD;&#xA;    )&#xD;&#xA;    GROUP BY Project, Package, Version, FileNameKey&#xD;&#xA;) AS metrics&#xD;&#xA;USING (Project, Package, Version, FileNameKey)&#xD;&#xA;ORDER BY Project, Package, Action"
            type="System.String, System.Private.CoreLib, Version=8.0.0.0, Culture=neutral, PublicKeyToken=7cec85d7bea7798e" />
