        <Path value="UserDefined.DEEActionGroupComplexity"
            type="System.String, System.Private.CoreLib, Version=8.0.0.0, Culture=neutral, PublicKeyToken=7cec85d7bea7798e" />
        <QueryString
            value="SELECT&#xD;&#xA;    Project,&#xD;&#xA;    Package,&#xD;&#xA;    Version,&#xD;&#xA;    ActionGroup,&#xD;&#xA;    uniqExact(Action)                          AS DistinctActionsBound,&#xD;&#xA;    avgIf(Complexity, HasMetrics = 1)          AS AvgComplexity,&#xD;&#xA;    minIf(Complexity, HasMetrics = 1)          AS MinComplexity,&#xD;&#xA;    maxIf(Complexity, HasMetrics = 1)          AS MaxComplexity,&#xD;&#xA;    avgIf(LinesOfCode, HasMetrics = 1)         AS AvgLinesOfCode,&#xD;&#xA;    minIf(LinesOfCode, HasMetrics = 1)         AS MinLinesOfCode,&#xD;&#xA;    maxIf(LinesOfCode, HasMetrics = 1)         AS MaxLinesOfCode,&#xD;&#xA;    sum(HasMetrics)                            AS ActionsWithMetrics&#xD;&#xA;FROM&#xD;&#xA;(&#xD;&#xA;    SELECT DISTINCT&#xD;&#xA;        Project, Package, Version, ActionGroup, Action&#xD;&#xA;    FROM&#xD;&#xA;    (&#xD;&#xA;        SELECT&#xD;&#xA;            Enterprise_Name AS Project, Site_Name AS Package, Facility_Name AS Version,&#xD;&#xA;            Resource_Name AS Action,&#xD;&#xA;            JSONExtractString(Parameters_StringValues[indexOf(Parameters_Name, 'Content')][1], 'ActionGroup') AS ActionGroup&#xD;&#xA;        FROM PostTelemetry&#xD;&#xA;        WHERE Area_Name = 'DEEActionOrder'&#xD;&#xA;    )&#xD;&#xA;    WHERE ActionGroup != ''&#xD;&#xA;) AS ag&#xD;&#xA;LEFT JOIN&#xD;&#xA;(&#xD;&#xA;    SELECT&#xD;&#xA;        deeaction.Project AS Project,&#xD;&#xA;        deeaction.Package AS Package,&#xD;&#xA;        deeaction.Version AS Version,&#xD;&#xA;        deeaction.Action AS Action,&#xD;&#xA;        metrics.Complexity AS Complexity,&#xD;&#xA;        metrics.LinesOfCode AS LinesOfCode,&#xD;&#xA;        if(metrics.FileNameKey != '', 1, 0) AS HasMetrics&#xD;&#xA;    FROM&#xD;&#xA;    (&#xD;&#xA;        SELECT&#xD;&#xA;            Project, Package, Version, Action,&#xD;&#xA;            argMax(FileNameKey, _created_at) AS FileNameKey&#xD;&#xA;        FROM&#xD;&#xA;        (&#xD;&#xA;            SELECT&#xD;&#xA;                Enterprise_Name AS Project, Site_Name AS Package, Facility_Name AS Version,&#xD;&#xA;                Resource_Name AS Action, _created_at,&#xD;&#xA;                extract(JSONExtractString(Parameters_StringValues[indexOf(Parameters_Name, 'Content')][1], 'CodeFileRelativePath'), '([^/]+)$') AS FileNameKey&#xD;&#xA;            FROM PostTelemetry&#xD;&#xA;            WHERE Area_Name = '&lt;SM&gt;DEEAction'&#xD;&#xA;        )&#xD;&#xA;        GROUP BY Project, Package, Version, Action&#xD;&#xA;    ) AS deeaction&#xD;&#xA;    LEFT JOIN&#xD;&#xA;    (&#xD;&#xA;        SELECT&#xD;&#xA;            Project, Package, Version, FileNameKey,&#xD;&#xA;            argMax(LoC, _created_at)        AS LinesOfCode,&#xD;&#xA;            argMax(Complexity, _created_at) AS Complexity&#xD;&#xA;        FROM&#xD;&#xA;        (&#xD;&#xA;            SELECT&#xD;&#xA;                Enterprise_Name AS Project, Site_Name AS Package, Facility_Name AS Version, _created_at,&#xD;&#xA;                Parameters_StringValues[indexOf(Parameters_Name, 'FileName')][1]    AS FileNameKey,&#xD;&#xA;                Parameters_NumericValues[indexOf(Parameters_Name, 'LoC')][1]        AS LoC,&#xD;&#xA;                Parameters_NumericValues[indexOf(Parameters_Name, 'Complexity')][1] AS Complexity&#xD;&#xA;            FROM PostTelemetry&#xD;&#xA;            WHERE Area_Name = 'DEE' AND Resource_Name = 'codeExecution'&#xD;&#xA;        )&#xD;&#xA;        GROUP BY Project, Package, Version, FileNameKey&#xD;&#xA;    ) AS metrics&#xD;&#xA;    USING (Project, Package, Version, FileNameKey)&#xD;&#xA;) AS m&#xD;&#xA;USING (Project, Package, Version, Action)&#xD;&#xA;GROUP BY Project, Package, Version, ActionGroup&#xD;&#xA;ORDER BY Project, Package, ActionGroup"
            type="System.String, System.Private.CoreLib, Version=8.0.0.0, Culture=neutral, PublicKeyToken=7cec85d7bea7798e" />
