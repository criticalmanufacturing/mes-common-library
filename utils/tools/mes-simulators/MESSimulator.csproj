<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.10" />
  </ItemGroup>

  <ItemGroup>
    <!-- From the CMF feed (see nuget.config); brings its own dependencies (Polly, OpenTelemetry, IdentityModel, WebApi.Client, ...) -->
    <PackageReference Include="Cmf.LightBusinessObjects" Version="12.0.0-beta.2-20261001134957" />
  </ItemGroup>

  <ItemGroup>
    <!-- Unit and integration tests live in their own projects under Tests\ -->
    <Compile Remove="Tests\**" />
    <None Remove="Tests\**" />
    <EmbeddedResource Remove="Tests\**" />
    <InternalsVisibleTo Include="MESSimulator.IntegrationTests" />
    <InternalsVisibleTo Include="MESSimulator.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- The line files (pass one with the line argument) -->
    <None Update="simulationConfiguration.*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
