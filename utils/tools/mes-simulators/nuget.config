<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- Critical Manufacturing feed: needs credentials for the source key "CMF" (see README, "Building") -->
    <add key="CMF" value="https://criticalmanufacturing.io/repository/nuget-hosted/index.json" protocolVersion="3" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <!-- Cmf.* packages only ever come from the CMF feed, everything else only from nuget.org -->
  <packageSourceMapping>
    <packageSource key="CMF">
      <package pattern="Cmf.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
  <solution>
    <add key="disableSourceControlIntegration" value="true" />
  </solution>
</configuration>
