{
  "ClientConfiguration": {
    "Connection": {
      "EnvironmentAddress": "https://<mes-host>"
    },
    "Authentication": {
      "ClientId": "MES",
      "SecurityAccessToken": "<personal access token: never commit it; or set MESSIM_ClientConfiguration__Authentication__SecurityAccessToken>"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "MESSimulator": "Information",
      "Microsoft": "Warning",
      "System": "Warning"
    }
  },
  "Simulation": {
    "Speed": 100
  },
  "Mes": {
    "RetryMaxAttempts": 5,
    "RetryDelay": "00:00:01",
    "MaxConcurrentCalls": 16
  },
  "Diagnostics": {
    "LogMesCallDurations": false,
    "SummaryOnExit": true
  }
}
