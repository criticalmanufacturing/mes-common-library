<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Cmf.Foundation.BaseTestsUtils" Version="11.3.3" />
    <PackageReference Include="Cmf.MessageBus.Client" Version="11.3.3" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../Cmf.Community.IoTMESInteroperability.Orchestration/Cmf.Community.IoTMESInteroperability.Orchestration.csproj" />
    <ProjectReference Include="../../../IoTMESInteroperability.Data/DEEs/Cmf.Community.IoTMESInteroperability.Actions.csproj" />
  </ItemGroup>
  <Target Name="ValidateProductionTestFileParity" BeforeTargets="PrepareForBuild">
    <ItemGroup>
      <DeeSource Include="../../../IoTMESInteroperability.Data/DEEs/**/*.cs"
                 Exclude="../../../IoTMESInteroperability.Data/DEEs/DeeDevBase.cs;../../../IoTMESInteroperability.Data/DEEs/Properties/**/*.cs;../../../IoTMESInteroperability.Data/DEEs/bin/**/*.cs;../../../IoTMESInteroperability.Data/DEEs/obj/**/*.cs" />
      <OrchestrationSource Include="../../Cmf.Community.IoTMESInteroperability.Orchestration/*.cs"
                           Exclude="../../Cmf.Community.IoTMESInteroperability.Orchestration/OrchestrationStartupModule.cs" />
      <ExpectedProductionTest Include="@(DeeSource->'$(MSBuildProjectDirectory)/%(Filename)Tests.cs')" />
      <ExpectedProductionTest Include="@(OrchestrationSource->'$(MSBuildProjectDirectory)/%(Filename)Tests.cs')" />
      <MissingProductionTest Include="@(ExpectedProductionTest)" Condition="!Exists('%(FullPath)')" />
    </ItemGroup>
    <Error Condition="'@(MissingProductionTest)' != ''"
           Text="Missing dedicated test file(s): @(MissingProductionTest). Add one &lt;SourceName&gt;Tests.cs file for each DEE and orchestration source." />
  </Target>
</Project>
