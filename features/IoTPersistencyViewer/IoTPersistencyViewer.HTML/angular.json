{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "Cmf.Custom.HTML": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "less"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": {
              "base": "dist/cmf.custom.html",
              "browser": ""
            },
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": [
              "zone.js",
              "@angular/localize/init"
            ],
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "less",
            "assets": [
              "src/assets",
              "src/manifest.webmanifest",
              {
                "glob": "favicon.ico",
                "input": "node_modules/cmf-core/assets/img",
                "output": ""
              },
              {
                "glob": "**/icon-*.png",
                "input": "node_modules/cmf-core/assets/img/icons",
                "output": "assets/icons"
              },
              {
                "glob": "**/*",
                "input": "node_modules/cmf-core/assets/img/themes",
                "output": "assets/themes"
              },
              {
                "glob": "**/*",
                "input": "node_modules/cmf-core/assets/js",
                "output": ""
              },
              {
                "glob": "**/*",
                "input": "node_modules/cmf-core-fablive/assets",
                "output": "assets/fablive"
              },
              {
                "glob": "**/*",
                "input": "node_modules/cmf-core-augmentedreality/assets",
                "output": "assets/augmentedreality"
              },
              {
                "glob": "**/*",
                "input": "node_modules/cmf-core-shell/assets",
                "output": "assets/shell"
              },
              {
                "glob": "artoolkit_wasm.wasm",
                "input": "node_modules/cmf-artoolkit",
                "output": "cmf-artoolkit"
              },
              {
                "glob": "camera_para.dat",
                "input": "node_modules/cmf-artoolkit",
                "output": "cmf-artoolkit"
              },
              {
                "glob": "index.d.ts",
                "input": "node_modules/cmf-lbos",
                "output": "assets/@types/cmf-lbos"
              },
              {
                "glob": "**/*.svg",
                "input": "node_modules/cmf-mes-business-controls/assets/product/img",
                "output": "assets/business-controls/product"
              },
              {
                "glob": "**/*",
                "input": "node_modules/cmf-core-iot/assets",
                "output": "assets/iot"
              },
              {
                "glob": "**/*.wasm",
                "input": "node_modules/zxing-wasm/dist/reader",
                "output": "zxing-wasm/reader"
              },
              {
                "glob": "**/*.generated.schema.json",
                "input": "node_modules/cmf-core-ui/assets/ui-page-schemas",
                "output": "assets/generated-schemas"
              },
              {
                "glob": "**/*.generated.schema.json",
                "input": "node_modules/cmf-mes-ui/assets/ui-page-schemas",
                "output": "assets/generated-schemas"
              }
            ],
            "styles": [
              "src/styles.less",
              "node_modules/toastr/toastr.less",
              "node_modules/bootstrap/dist/css/bootstrap.css",
              "node_modules/jquery-ui/themes/base/dialog.css",
              "node_modules/jquery-ui/themes/base/core.css",
              "node_modules/cmf-core-connect-iot/assets/fonts/coreconnectiot/icon-core-connect-iot-font.less",
              "node_modules/cmf-core-iotevents/assets/fonts/coreiotevents/icon-core-iot-events-font.less",
              "node_modules/cmf-mes-kpi/assets/fonts/meskpi/icon-mes-kpi-font.less",
              "node_modules/cmf-mes/assets/style/styles.less",
              {
                "inject": false,
                "bundleName": "cmf.style.light",
                "input": "node_modules/cmf-mes/assets/style/themes/cmf.style.light/cmf.style.light.less"
              },
              {
                "inject": false,
                "bundleName": "cmf.style.light.accessibility",
                "input": "node_modules/cmf-mes/assets/style/themes/cmf.style.light.accessibility/cmf.style.light.accessibility.less"
              },
              {
                "inject": false,
                "bundleName": "cmf.style.contrast",
                "input": "node_modules/cmf-mes/assets/style/themes/cmf.style.contrast/cmf.style.contrast.less"
              },
              {
                "inject": false,
                "bundleName": "cmf.style.contrast.accessibility",
                "input": "node_modules/cmf-mes/assets/style/themes/cmf.style.contrast.accessibility/cmf.style.contrast.accessibility.less"
              },
              {
                "inject": false,
                "bundleName": "cmf.style.dark",
                "input": "node_modules/cmf-mes/assets/style/themes/cmf.style.dark/cmf.style.dark.less"
              },
              {
                "inject": false,
                "bundleName": "cmf.style.dark.accessibility",
                "input": "node_modules/cmf-mes/assets/style/themes/cmf.style.dark.accessibility/cmf.style.dark.accessibility.less"
              },
              "node_modules/cmf-core/assets/style/vendor/kendo-ui.scss"
            ],
            "scripts": [
              "node_modules/jquery/dist/jquery.min.js",
              "node_modules/toastr/toastr.js",
              "node_modules/bootstrap/js/collapse.js",
              "node_modules/bootstrap/js/transition.js",
              "node_modules/bootstrap/js/dropdown.js"
            ],
            "preserveSymlinks": true,
            "allowedCommonJsDependencies": [
              "quagga",
              "html2canvas",
              "zipson",
              "decimal.js",
              "moment",
              "moment-duration-format",
              "backbone",
              "jquery",
              "lodash",
              "raf",
              "rgbcolor",
              "core-js",
              "dompurify",
              "jsonata",
              "xpath",
              "xmldom",
              "inversify",
              "escape-latex",
              "fraction.js",
              "complex.js",
              "javascript-natural-sort",
              "seedrandom",
              "typed-function",
              "buffer"
            ],
            "loader": {
              ".css": "empty"
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "2kb",
                  "maximumError": "4kb"
                }
              ],
              "outputHashing": "all",
              "serviceWorker": "ngsw-config.json"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "i18n-extract": {
              "externalDependencies": [
                "@criticalmanufacturing/connect-iot-controller-engine-core-tasks",
                "@criticalmanufacturing/connect-iot-controller-engine-factoryautomation-tasks",
                "@criticalmanufacturing/connect-iot-controller-engine-filedrivers-tasks",
                "@criticalmanufacturing/connect-iot-controller-engine-fujinexim-tasks",
                "@criticalmanufacturing/connect-iot-controller-engine-ipccfx-tasks",
                "@criticalmanufacturing/connect-iot-controller-engine-mes-tasks",
                "@criticalmanufacturing/connect-iot-controller-engine-oib-tasks",
                "@criticalmanufacturing/connect-iot-controller-engine-opcua-tasks",
                "@criticalmanufacturing/connect-iot-controller-engine-panacim-tasks",
                "@criticalmanufacturing/connect-iot-controller-engine-secsgem-tasks",
                "cmf-core",
                "cmf-core-admin-config",
                "cmf-core-admin-dee",
                "cmf-core-admin-entitytype",
                "cmf-core-admin-erp",
                "cmf-core-admin-host",
                "cmf-core-admin-i18n",
                "cmf-core-admin-messagebus",
                "cmf-core-admin-queries",
                "cmf-core-admin-shortcuts",
                "cmf-core-admin-statemodel",
                "cmf-core-admin-tables",
                "cmf-core-app",
                "cmf-core-augmentedreality",
                "cmf-core-business-controls",
                "cmf-core-camera",
                "cmf-core-changeset",
                "cmf-core-chatbot",
                "cmf-core-checklist",
                "cmf-core-connect-iot",
                "cmf-core-controls",
                "cmf-core-dashboards",
                "cmf-core-documents",
                "cmf-core-enterprise",
                "cmf-core-event",
                "cmf-core-examples",
                "cmf-core-fablive",
                "cmf-core-folder",
                "cmf-core-iot",
                "cmf-core-iotevents",
                "cmf-core-masterdata",
                "cmf-core-multimedia",
                "cmf-core-notification",
                "cmf-core-reports",
                "cmf-core-rule",
                "cmf-core-search",
                "cmf-core-security",
                "cmf-core-shell",
                "cmf-core-site",
                "cmf-core-ui",
                "cmf-mes",
                "cmf-mes-area",
                "cmf-mes-bom",
                "cmf-mes-business-controls",
                "cmf-mes-checklist",
                "cmf-mes-competence",
                "cmf-mes-container",
                "cmf-mes-datacollection",
                "cmf-mes-employee",
                "cmf-mes-examples",
                "cmf-mes-experiment",
                "cmf-mes-facility",
                "cmf-mes-flow",
                "cmf-mes-kpi",
                "cmf-mes-maintenance",
                "cmf-mes-mapping",
                "cmf-mes-material",
                "cmf-mes-materiallogistics",
                "cmf-mes-newproductintroduction",
                "cmf-mes-notification",
                "cmf-mes-plan",
                "cmf-mes-printabledocument",
                "cmf-mes-product",
                "cmf-mes-productionorder",
                "cmf-mes-protocol",
                "cmf-mes-recipe",
                "cmf-mes-resource",
                "cmf-mes-sampling",
                "cmf-mes-scheduling",
                "cmf-mes-shift",
                "cmf-mes-statisticalprocesscontrol",
                "cmf-mes-step",
                "cmf-mes-task",
                "cmf-mes-ui",
                "cmf-mes-warehouse",
                "cmf-mes-weighdispense",
                "cmf-core-genai",
                "cmf-core-workflow"
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "Cmf.Custom.HTML:build:production"
            },
            "development": {
              "buildTarget": "Cmf.Custom.HTML:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "buildTarget": "Cmf.Custom.HTML:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "tsconfig.spec.json",
            "inlineStyleLanguage": "less",
            "assets": [
              "src/favicon.ico",
              "src/assets",
              "src/manifest.webmanifest"
            ],
            "styles": [
              "src/styles.less"
            ],
            "scripts": []
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "src/**/*.ts",
              "src/**/*.html"
            ]
          }
        }
      }
    },
    "customization-json-persistency": {
      "projectType": "library",
      "root": "projects/customization-json-persistency",
      "sourceRoot": "projects/customization-json-persistency/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/customization-json-persistency/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/customization-json-persistency/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/customization-json-persistency/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "tsConfig": "projects/customization-json-persistency/tsconfig.spec.json",
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ]
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/customization-json-persistency/**/*.ts",
              "projects/customization-json-persistency/**/*.html"
            ]
          }
        }
      }
    }
  },
  "cli": {
    "schematicCollections": [
      "@criticalmanufacturing/ngx-schematics",
      "@angular-eslint/schematics"
    ],
    "analytics": false
  },
  "schematics": {
    "@schematics/angular:component": {
      "type": "component"
    },
    "@schematics/angular:directive": {
      "type": "directive"
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  }
}