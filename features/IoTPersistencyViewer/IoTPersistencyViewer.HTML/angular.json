{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "Cmf.Custom.HTML": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "less"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": {
              "base": "dist/cmf.custom.html",
              "browser": ""
            },
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": [
              "zone.js",
              "reflect-metadata"
            ],
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "less",
            "assets": [
              "src/assets",
              "src/manifest.webmanifest",
              {
                "glob": "favicon.ico",
                "input": "node_modules/cmf-core/assets/img",
                "output": ""
              },
              {
                "glob": "**/icon-*.png",
                "input": "node_modules/cmf-core/assets/img/icons",
                "output": "assets/icons"
              },
              {
                "glob": "**/*",
                "input": "node_modules/cmf-core/assets/img/flags",
                "output": "assets/flags"
              },
              {
                "glob": "**/*",
                "input": "node_modules/cmf-core/assets/img/themes",
                "output": "assets/themes"
              },
              {
                "glob": "**/*",
                "input": "node_modules/cmf-core/assets/js",
                "output": ""
              },
              {
                "glob": "**/*",
                "input": "node_modules/monaco-editor/min/vs",
                "output": "monaco-editor/vs"
              },
              {
                "glob": "**/*",
                "input": "node_modules/cmf-core-fablive/assets",
                "output": "assets/fablive"
              },
              {
                "glob": "**/*",
                "input": "node_modules/cmf-core-augmentedreality/assets",
                "output": "assets/augmentedreality"
              },
              {
                "glob": "**/*",
                "input": "node_modules/cmf-core-shell/assets",
                "output": "assets/shell"
              },
              {
                "glob": "artoolkit_wasm.wasm",
                "input": "node_modules/cmf-artoolkit",
                "output": "cmf-artoolkit"
              },
              {
                "glob": "camera_para.dat",
                "input": "node_modules/cmf-artoolkit",
                "output": "cmf-artoolkit"
              },
              {
                "glob": "index.d.ts",
                "input": "node_modules/cmf-lbos",
                "output": "assets/@types/cmf-lbos"
              },
              {
                "glob": "**/*.svg",
                "input": "node_modules/cmf-mes-business-controls/assets/product/img",
                "output": "assets/business-controls/product"
              }
            ],
            "styles": [
              "src/styles.less",
              "node_modules/toastr/toastr.less",
              "node_modules/bootstrap/dist/css/bootstrap.css",
              "node_modules/cmf.kendoui/styles/kendo.common.min.css",
              "node_modules/jquery-ui/themes/base/dialog.css",
              "node_modules/jquery-ui/themes/base/core.css",
              "node_modules/cmf-core-connect-iot/assets/fonts/coreconnectiot/icon-core-connect-iot-font.less",
              "node_modules/cmf-core-iotevents/assets/fonts/coreiotevents/icon-core-iot-events-font.less",
              "node_modules/@criticalmanufacturing/connect-iot-controller-engine-core-tasks/assets/font/icon-core-tasks-connect-iot-font.less",
              "node_modules/@criticalmanufacturing/connect-iot-controller-engine-filedrivers-tasks/assets/font/icon-filesbased-iot-font.less",
              "node_modules/@criticalmanufacturing/connect-iot-controller-engine-oib-tasks/assets/font/icon-oib-tasks-connect-iot-font.less",
              "node_modules/@criticalmanufacturing/connect-iot-controller-engine-secsgem-tasks/assets/font/icon-secsgem-iot-font.less",
              "node_modules/@criticalmanufacturing/connect-iot-controller-engine-factoryautomation-tasks/assets/font/icon-factoryautomation-tasks-connect-iot-font.less",
              "node_modules/@criticalmanufacturing/connect-iot-controller-engine-opcua-tasks/assets/font/icon-opcua-tasks-connect-iot-font.less",
              "node_modules/cmf-mes-kpi/assets/fonts/meskpi/icon-mes-kpi-font.less",
              "node_modules/cmf-mes/assets/style/styles.less",
              "node_modules/@criticalmanufacturing/connect-iot-controller-engine-mes-tasks/assets/font/icon-mes-connect-iot-font.less",
              {
                "inject": false,
                "bundleName": "cmf.style.blue",
                "input": "node_modules/cmf-mes/assets/style/themes/cmf.style.blue/cmf.style.blue.less"
              },
              {
                "inject": false,
                "bundleName": "cmf.style.blue.accessibility",
                "input": "node_modules/cmf-mes/assets/style/themes/cmf.style.blue.accessibility/cmf.style.blue.accessibility.less"
              },
              {
                "inject": false,
                "bundleName": "cmf.style.contrast",
                "input": "node_modules/cmf-mes/assets/style/themes/cmf.style.contrast/cmf.style.contrast.less"
              },
              {
                "inject": false,
                "bundleName": "cmf.style.contrast.accessibility",
                "input": "node_modules/cmf-mes/assets/style/themes/cmf.style.contrast.accessibility/cmf.style.contrast.accessibility.less"
              },
              {
                "inject": false,
                "bundleName": "cmf.style.dark",
                "input": "node_modules/cmf-mes/assets/style/themes/cmf.style.dark/cmf.style.dark.less"
              },
              {
                "inject": false,
                "bundleName": "cmf.style.dark.accessibility",
                "input": "node_modules/cmf-mes/assets/style/themes/cmf.style.dark.accessibility/cmf.style.dark.accessibility.less"
              },
              {
                "inject": false,
                "bundleName": "cmf.style.gray",
                "input": "node_modules/cmf-mes/assets/style/themes/cmf.style.gray/cmf.style.gray.less"
              },
              {
                "inject": false,
                "bundleName": "cmf.style.gray.accessibility",
                "input": "node_modules/cmf-mes/assets/style/themes/cmf.style.gray.accessibility/cmf.style.gray.accessibility.less"
              }
            ],
            "scripts": [
              "node_modules/jquery/dist/jquery.min.js",
              "node_modules/toastr/toastr.js",
              "node_modules/jquery-ui/ui/version.js",
              "node_modules/jquery-ui/ui/data.js",
              "node_modules/jquery-ui/ui/plugin.js",
              "node_modules/jquery-ui/ui/scroll-parent.js",
              "node_modules/jquery-ui/ui/safe-active-element.js",
              "node_modules/jquery-ui/ui/unique-id.js",
              "node_modules/jquery-ui/ui/focusable.js",
              "node_modules/jquery-ui/ui/tabbable.js",
              "node_modules/jquery-ui/ui/keycode.js",
              "node_modules/jquery-ui/ui/safe-blur.js",
              "node_modules/jquery-ui/ui/widget.js",
              "node_modules/jquery-ui/ui/widgets/button.js",
              "node_modules/jquery-ui/ui/widgets/mouse.js",
              "node_modules/jquery-ui/ui/widgets/dialog.js",
              "node_modules/jquery-ui/ui/widgets/draggable.js",
              "node_modules/bootstrap/js/collapse.js",
              "node_modules/bootstrap/js/transition.js",
              "node_modules/bootstrap/js/dropdown.js",
              "node_modules/cmf.kendoui/js/kendo.core.min.js",
              "node_modules/cmf.kendoui/js/kendo.fx.min.js",
              "node_modules/cmf.kendoui/js/kendo.ooxml.min.js",
              "node_modules/cmf.kendoui/js/kendo.excel.min.js",
              "node_modules/cmf.kendoui/js/kendo.data.odata.min.js",
              "node_modules/cmf.kendoui/js/kendo.data.xml.min.js",
              "node_modules/cmf.kendoui/js/kendo.data.min.js",
              "node_modules/cmf.kendoui/js/kendo.popup.min.js",
              "node_modules/cmf.kendoui/js/kendo.menu.min.js",
              "node_modules/cmf.kendoui/js/kendo.userevents.min.js",
              "node_modules/cmf.kendoui/js/kendo.draganddrop.min.js",
              "node_modules/cmf.kendoui/js/kendo.floatinglabel.min.js",
              "node_modules/cmf.kendoui/js/kendo.maskedtextbox.min.js",
              "node_modules/cmf.kendoui/js/kendo.list.min.js",
              "node_modules/cmf.kendoui/js/kendo.mobile.scroller.min.js",
              "node_modules/cmf.kendoui/js/kendo.virtuallist.min.js",
              "node_modules/cmf.kendoui/js/kendo.dropdownlist.min.js",
              "node_modules/cmf.kendoui/js/kendo.combobox.min.js",
              "node_modules/cmf.kendoui/js/kendo.autocomplete.min.js",
              "node_modules/cmf.kendoui/js/kendo.window.min.js",
              "node_modules/cmf.kendoui/js/kendo.color.min.js",
              "node_modules/cmf.kendoui/js/kendo.slider.min.js",
              "node_modules/cmf.kendoui/js/kendo.button.min.js",
              "node_modules/cmf.kendoui/js/kendo.colorpicker.min.js",
              "node_modules/cmf.kendoui/js/kendo.numerictextbox.min.js",
              "node_modules/cmf.kendoui/js/kendo.tabstrip.min.js",
              "node_modules/cmf.kendoui/js/kendo.editor.min.js",
              "node_modules/cmf.kendoui/js/kendo.columnsorter.min.js",
              "node_modules/cmf.kendoui/js/kendo.resizable.min.js",
              "node_modules/cmf.kendoui/js/kendo.selectable.min.js",
              "node_modules/cmf.kendoui/js/kendo.pager.min.js",
              "node_modules/cmf.kendoui/js/kendo.grid.min.js",
              "node_modules/cmf.kendoui/js/kendo.splitter.min.js",
              "node_modules/cmf.kendoui/js/kendo.tooltip.min.js",
              "node_modules/cmf.kendoui/js/kendo.drawing.min.js",
              "node_modules/cmf.kendoui/js/kendo.dataviz.core.min.js",
              "node_modules/cmf.kendoui/js/kendo.dataviz.chart.min.js",
              "node_modules/cmf.kendoui/js/kendo.dataviz.themes.min.js",
              "node_modules/cmf.kendoui/js/kendo.dataviz.treemap.min.js",
              "node_modules/cmf.kendoui/js/kendo.calendar.min.js",
              "node_modules/cmf.kendoui/js/kendo.multiviewcalendar.min.js",
              "node_modules/cmf.kendoui/js/kendo.pdf.min.js",
              {
                "bundleName": "jszip",
                "inject": false,
                "input": "node_modules/cmf.kendoui/js/jszip.min.js"
              }
            ],
            "preserveSymlinks": true,
            "allowedCommonJsDependencies": [
              "quagga",
              "html2canvas",
              "zipson",
              "decimal.js",
              "moment",
              "moment-duration-format",
              "backbone",
              "jquery",
              "lodash",
              "raf",
              "rgbcolor",
              "core-js",
              "dompurify",
              "jsonata",
              "xpath",
              "xmldom",
              "inversify",
              "escape-latex",
              "fraction.js",
              "complex.js",
              "javascript-natural-sort",
              "seedrandom",
              "typed-function",
              "buffer"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "2kb",
                  "maximumError": "4kb"
                }
              ],
              "outputHashing": "all",
              "serviceWorker": "ngsw-config.json"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "i18n-extract": {
              "externalDependencies": [
                "@criticalmanufacturing/connect-iot-controller-engine-core-tasks",
                "@criticalmanufacturing/connect-iot-controller-engine-factoryautomation-tasks",
                "@criticalmanufacturing/connect-iot-controller-engine-filedrivers-tasks",
                "@criticalmanufacturing/connect-iot-controller-engine-fujinexim-tasks",
                "@criticalmanufacturing/connect-iot-controller-engine-ipccfx-tasks",
                "@criticalmanufacturing/connect-iot-controller-engine-mes-tasks",
                "@criticalmanufacturing/connect-iot-controller-engine-oib-tasks",
                "@criticalmanufacturing/connect-iot-controller-engine-opcua-tasks",
                "@criticalmanufacturing/connect-iot-controller-engine-panacim-tasks",
                "@criticalmanufacturing/connect-iot-controller-engine-secsgem-tasks",
                "cmf-core",
                "cmf-core-admin-config",
                "cmf-core-admin-dee",
                "cmf-core-admin-entitytype",
                "cmf-core-admin-erp",
                "cmf-core-admin-host",
                "cmf-core-admin-i18n",
                "cmf-core-admin-messagebus",
                "cmf-core-admin-queries",
                "cmf-core-admin-shortcuts",
                "cmf-core-admin-statemodel",
                "cmf-core-admin-tables",
                "cmf-core-app",
                "cmf-core-augmentedreality",
                "cmf-core-business-controls",
                "cmf-core-camera",
                "cmf-core-changeset",
                "cmf-core-chatbot",
                "cmf-core-checklist",
                "cmf-core-connect-iot",
                "cmf-core-controls",
                "cmf-core-dashboards",
                "cmf-core-documents",
                "cmf-core-enterprise",
                "cmf-core-event",
                "cmf-core-examples",
                "cmf-core-fablive",
                "cmf-core-folder",
                "cmf-core-iot",
                "cmf-core-iotevents",
                "cmf-core-masterdata",
                "cmf-core-multimedia",
                "cmf-core-notification",
                "cmf-core-reports",
                "cmf-core-rule",
                "cmf-core-search",
                "cmf-core-security",
                "cmf-core-shell",
                "cmf-core-site",
                "cmf-core-ui",
                "cmf-mes",
                "cmf-mes-area",
                "cmf-mes-bom",
                "cmf-mes-business-controls",
                "cmf-mes-checklist",
                "cmf-mes-competence",
                "cmf-mes-container",
                "cmf-mes-datacollection",
                "cmf-mes-employee",
                "cmf-mes-examples",
                "cmf-mes-experiment",
                "cmf-mes-facility",
                "cmf-mes-flow",
                "cmf-mes-kpi",
                "cmf-mes-maintenance",
                "cmf-mes-mapping",
                "cmf-mes-material",
                "cmf-mes-materiallogistics",
                "cmf-mes-newproductintroduction",
                "cmf-mes-notification",
                "cmf-mes-plan",
                "cmf-mes-printabledocument",
                "cmf-mes-product",
                "cmf-mes-productionorder",
                "cmf-mes-protocol",
                "cmf-mes-recipe",
                "cmf-mes-resource",
                "cmf-mes-sampling",
                "cmf-mes-scheduling",
                "cmf-mes-shift",
                "cmf-mes-statisticalprocesscontrol",
                "cmf-mes-step",
                "cmf-mes-task",
                "cmf-mes-ui",
                "cmf-mes-warehouse",
                "cmf-mes-weighdispense"
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "Cmf.Custom.HTML:build:production"
            },
            "development": {
              "buildTarget": "Cmf.Custom.HTML:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "buildTarget": "Cmf.Custom.HTML:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "tsconfig.spec.json",
            "inlineStyleLanguage": "less",
            "assets": [
              "src/favicon.ico",
              "src/assets",
              "src/manifest.webmanifest"
            ],
            "styles": [
              "src/styles.less"
            ],
            "scripts": []
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "src/**/*.ts",
              "src/**/*.html"
            ]
          }
        }
      }
    },
    "customization-json-persistency": {
      "projectType": "library",
      "root": "projects/customization-json-persistency",
      "sourceRoot": "projects/customization-json-persistency/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/customization-json-persistency/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/customization-json-persistency/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/customization-json-persistency/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "tsConfig": "projects/customization-json-persistency/tsconfig.spec.json",
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ]
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/customization-json-persistency/**/*.ts",
              "projects/customization-json-persistency/**/*.html"
            ]
          }
        }
      }
    }
  },
  "cli": {
    "schematicCollections": [
      "@criticalmanufacturing/ngx-schematics",
      "@angular-eslint/schematics"
    ]
  }
}