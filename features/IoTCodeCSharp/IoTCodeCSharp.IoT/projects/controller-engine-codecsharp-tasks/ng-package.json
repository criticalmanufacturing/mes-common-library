{
  "$schema": "../../node_modules/ng-packagr/ng-package.schema.json",
  "deleteDestPath": false,
  "dest": "../../dist/controller-engine-codecsharp-tasks",
  "lib": {
    "entryFile": "src/public-api-designer.ts"
  },
  "assets": [
    {
      "glob": "**/*",
      "input": "roslyn-host/publish",
      "output": "roslyn-host"
    },
    {
      "glob": "**/*",
      "input": "roslyn-compiler/publish/wwwroot",
      "output": "roslyn-compiler"
    }
  ]
}