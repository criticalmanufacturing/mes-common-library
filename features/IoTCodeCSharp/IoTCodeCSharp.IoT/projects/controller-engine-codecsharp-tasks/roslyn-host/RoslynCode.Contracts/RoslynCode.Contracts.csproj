<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Consumed by the browser Roslyn compiler (see RoslynCode.Compiler.csproj) so completion/hover
         for _framework.* shows the XML doc comments from ExecutionContracts.cs instead of nothing. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
  <ItemGroup>
    <!-- Copied to RoslynCode.Host's own output separately; not needed as a compile-time-only reference here -->
    <Reference Include="Cmf.LightBusinessObjects">
      <HintPath>dependencies/Cmf.LightBusinessObjects.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>